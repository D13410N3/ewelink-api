# Required: authenticated eWeLink MCP streamable-HTTP endpoint.
# Obtain this URL from eWeLink; do not commit a real key or share it publicly.
EWELINK_MCP_URL=https://eu-apia.coolkit.cc/v2/mcp/passthrough?key=REPLACE_WITH_YOUR_ENCODED_KEY

# Optional HTTP listener address. Default: :8080
LISTEN_ADDR=:8080

# Optional authoritative device-cache refresh interval. Default: 1m
REFRESH_INTERVAL=1m

# Cache backend: memory (default) or redis.
CACHE_MODE=memory

# Redis connection settings. Used only when CACHE_MODE=redis.
# Defaults: 127.0.0.1:6379, database 0, and no authentication.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_AUTH=
